[Unit]
Description=FleetDeck %i security briefing
Wants=network-online.target
After=network-online.target

[Service]
Type=oneshot
EnvironmentFile=/etc/fleetdeck/reports/%i.env
StateDirectory=fleetdeck-briefing-%i
StateDirectoryMode=0700
UMask=0077
# REPORT_OPTIONS is a trusted list of arguments, not shell commands.
ExecStart=/usr/local/bin/fleetdeck --config ${REPORT_CONFIG} security report --edition %i --notify --delivery-state /var/lib/fleetdeck-briefing-%i/state.json $REPORT_OPTIONS
StandardOutput=null
TimeoutStartSec=2min
NoNewPrivileges=true
CapabilityBoundingSet=
AmbientCapabilities=
PrivateDevices=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=strict
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
RestrictNamespaces=true
RestrictSUIDSGID=true
LockPersonality=true
InaccessiblePaths=-/run/docker.sock
MemoryMax=128M
TasksMax=32
CPUQuota=25%
